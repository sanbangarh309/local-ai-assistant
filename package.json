{
  "name": "local-ai-assistant",
  "displayName": "local-ai-assistant",
  "description": "Local AI Assistant using LM Studio",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.108.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "local-ai-assistant.askAI",
        "title": "Ask AI"
      }
    ],

    "viewsContainers": {
      "activitybar": [
        {
          "id": "local-ai",
          "title": "Local AI",
          "icon": "media/icon.svg"
        }
      ]
    },

    "views": {
      "local-ai": [
        {
          "type": "webview",
          "id": "local-ai-chat",
          "name": "Chat"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "axios": "^1.18.0"
  }
}
