{
  "name": "local-ai-assistant",
  "displayName": "local-ai-assistant",
  "description": "Local AI Assistant using LM Studio",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "publisher": "sandeep-bangarh",
  "activationEvents": [
    "onView:local-ai-chat",
    "onCommand:local-ai-assistant.askAI"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "local-ai-assistant.askAI",
        "title": "Ask AI"
      }
    ],

    "viewsContainers": {
      "activitybar": [
        {
          "id": "local-ai",
          "title": "Local AI",
          "icon": "media/icon.svg"
        }
      ]
    },

    "views": {
      "local-ai": [
        {
          "type": "webview",
          "id": "local-ai-chat",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "Local AI Assistant",
      "properties": {
        "local-ai-assistant.provider": {
          "type": "string",
          "enum": [
            "ollama",
            "lmstudio"
          ],
          "enumDescriptions": [
            "Use a local Ollama model",
            "Use LM Studio"
          ],
          "default": "ollama",
          "description": "AI provider used by Local AI Assistant"
        },

        "local-ai-assistant.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama server URL"
        },

        "local-ai-assistant.ollamaModel": {
          "type": "string",
          "default": "qwen3-coder:30b",
          "description": "Ollama model to use for coding"
        },

        "local-ai-assistant.ollamaKeepAlive": {
          "type": "string",
          "default": "5m",
          "description": "How long Ollama keeps the model loaded in memory between requests (e.g. \"5m\", \"1h\", or \"0\" to unload immediately). Lower this on memory-constrained machines."
        },

        "local-ai-assistant.ollamaNumCtx": {
          "type": "number",
          "default": 4096,
          "description": "Context window size (tokens) requested from Ollama. Lower this to reduce memory usage on large models."
        },

        "local-ai-assistant.lmStudioUrl": {
          "type": "string",
          "default": "http://localhost:1234",
          "description": "LM Studio server URL"
        },

        "local-ai-assistant.lmStudioModel": {
          "type": "string",
          "default": "local-model",
          "description": "LM Studio model identifier"
        },

        "local-ai-assistant.requestTimeoutMs": {
          "type": "number",
          "default": 300000,
          "description": "How long to wait (in milliseconds) for the model to respond before timing out. Large local models can take several minutes, especially on a cold load or a large prompt."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "axios": "^1.18.0"
  }
}
